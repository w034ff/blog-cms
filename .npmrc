; --- Supply-chain hardening (reviewed; do not relax without sign-off) ---
; Cooldown: do not install package versions published within the last N days.
; Mitigates malicious freshly-published releases that get caught/unpublished quickly.
; npm 11.11 honors this from .npmrc (a too-new version fails with ETARGET); still pass
; --min-release-age 7 on the CLI too, so the cooldown survives a missing .npmrc.
min-release-age=7
; Block arbitrary pre/post-install lifecycle scripts. Build trusted native deps
; explicitly: npm rebuild better-sqlite3 --ignore-scripts=false --foreground-scripts
ignore-scripts=true
; Pin exact versions in package.json (no ^ ranges).
save-exact=true
