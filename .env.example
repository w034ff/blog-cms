# Copy to .env and fill in. .env is gitignored.

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Seed admin credentials (consumed by `npm run db:seed`, then stored hashed in the DB).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "true" only when serving over HTTPS (adds the Secure flag to the session cookie).
# Leave false for a home-server HTTP/LAN verification deploy.
SESSION_COOKIE_SECURE=false

SITE_ORIGIN=http://localhost:3001
